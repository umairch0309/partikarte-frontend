# Resend (server-side only — never expose in frontend code)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Partikarte <onboarding@resend.dev>
CONTACT_TO_EMAIL=your-team@example.com

# Optional local seed accounts (created automatically on first API call)
SEED_ADMIN_EMAIL=admin@partikarte.com
SEED_BUSINESS_EMAIL=business@partikarte.com
SEED_DEFAULT_PASSWORD=Password@123

# Set to true to print OTP codes in the terminal when Resend blocks test emails
DEV_LOG_OTP=true
